{
  "name": "ig-automatic-tools-api",
  "version": "1.0.0",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec node -r ts-node/register src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "node -r ts-node/register --test --test-concurrency=1 \"src/tests/**/*.test.ts\""
  }
}
