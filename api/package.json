{
  "name": "phanter-tools-api",
  "version": "1.0.0",
   "scripts": {
    "dev": "nodemon --watch src --ext ts --exec node -r ts-node/register src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "node -r ts-node/register --test --test-concurrency=1 \"src/tests/**/*.test.ts\"",
    "test:clean": "node -r ts-node/register src/scripts/cleanTestDb.ts",
    "cancel-pending": "node -r ts-node/register src/scripts/cancelPending.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "private": true
}
